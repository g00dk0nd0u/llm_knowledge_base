{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "type": "integer",
      "const": 1
    },
    "evidence_class": {
      "const": "vision_observation"
    },
    "request": {
      "$ref": "vision_stage_request_v1.schema.json"
    },
    "provider": {
      "type": "string",
      "pattern": "\\S"
    },
    "model": {
      "type": "string",
      "pattern": "\\S"
    },
    "observation": {
      "type": "string",
      "pattern": "\\S"
    },
    "status": {
      "enum": [
        "supported",
        "conflict",
        "ambiguous",
        "insufficient_evidence",
        "unresolved"
      ]
    },
    "provider_run_id": {
      "type": "string",
      "pattern": "\\S"
    },
    "observation_id": {
      "type": "string",
      "pattern": "^vision-stage-observation-[a-f0-9]{64}$"
    },
    "created_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?!0000)[0-9]{4}-(?:(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12][0-9]|3[01])|(?:04|06|09|11)-(?:0[1-9]|[12][0-9]|30)|02-(?:0[1-9]|1[0-9]|2[0-8]))|(?!0000)(?:[0-9]{2}(?:0[48]|[2468][048]|[13579][26])|(?:[02468][048]|[13579][26])00)-02-29)T(?:[01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9](?:\\.[0-9]+)?(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "contract_version",
    "evidence_class",
    "request",
    "provider",
    "model",
    "observation",
    "status",
    "provider_run_id",
    "observation_id",
    "created_at"
  ]
}
