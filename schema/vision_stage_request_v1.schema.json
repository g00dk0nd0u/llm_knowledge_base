{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "type": "integer",
      "const": 1
    },
    "stage": {
      "enum": [
        "V0",
        "V2"
      ]
    },
    "instruction": {
      "type": "string",
      "pattern": "\\S"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "vision_inspection_request_v1.schema.json"
      },
      "minItems": 1,
      "maxItems": 2
    },
    "relation": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "\\S"
            },
            "relation_type": {
              "type": "string",
              "pattern": "\\S"
            },
            "resolution_state": {
              "enum": [
                "exact",
                "resolved_deterministically"
              ]
            },
            "provenance": {
              "type": "string",
              "pattern": "\\S"
            },
            "source_refs": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "\\S"
                  }
                },
                "required": [
                  "id"
                ]
              }
            }
          },
          "required": [
            "id",
            "relation_type",
            "resolution_state",
            "provenance",
            "source_refs"
          ]
        }
      ]
    },
    "request_id": {
      "type": "string",
      "pattern": "^vision-stage-request-[a-f0-9]{64}$"
    }
  },
  "required": [
    "contract_version",
    "stage",
    "instruction",
    "inputs",
    "relation",
    "request_id"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "V0"
          }
        }
      },
      "then": {
        "properties": {
          "inputs": {
            "maxItems": 1,
            "items": {
              "allOf": [
                {
                  "$ref": "vision_inspection_request_v1.schema.json"
                },
                {
                  "properties": {
                    "input_scope": {
                      "const": "page"
                    }
                  }
                }
              ]
            }
          },
          "relation": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "inputs": {
            "minItems": 2
          },
          "relation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "\\S"
              },
              "relation_type": {
                "type": "string",
                "pattern": "\\S"
              },
              "resolution_state": {
                "enum": [
                  "exact",
                  "resolved_deterministically"
                ]
              },
              "provenance": {
                "type": "string",
                "pattern": "\\S"
              },
              "source_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "\\S"
                    }
                  },
                  "required": [
                    "id"
                  ]
                }
              }
            },
            "required": [
              "id",
              "relation_type",
              "resolution_state",
              "provenance",
              "source_refs"
            ]
          }
        }
      }
    }
  ]
}
