{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pdf_page.schema.json",
  "title": "Generated source-faithful PDF page primitives",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "source_file",
    "source_sha256",
    "page",
    "width_points",
    "height_points",
    "rotation",
    "media_box",
    "crop_box",
    "coordinate_space",
    "extraction_status",
    "image_count",
    "drawing_count",
    "text_blocks",
    "table_extraction",
    "tables"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "pattern": "^doc-[a-f0-9]{24}$"
    },
    "source_file": {
      "type": "string",
      "pattern": "^projects/[^/]+/source/.+\\.[Pp][Dd][Ff]$"
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "page": {
      "type": "integer",
      "minimum": 1
    },
    "width_points": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "height_points": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "rotation": {
      "enum": [
        0,
        90,
        180,
        270
      ]
    },
    "media_box": {
      "$ref": "#/$defs/bbox"
    },
    "crop_box": {
      "$ref": "#/$defs/bbox"
    },
    "coordinate_space": {
      "const": "pdf_points_top_left"
    },
    "extraction_status": {
      "enum": [
        "extracted",
        "minimal_text",
        "no_text"
      ]
    },
    "image_count": {
      "type": "integer",
      "minimum": 0
    },
    "drawing_count": {
      "type": "integer",
      "minimum": 0
    },
    "text_blocks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/block"
      }
    },
    "table_extraction": {
      "$ref": "#/$defs/table_extraction"
    },
    "tables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/table"
      }
    }
  },
  "$defs": {
    "bbox": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 4
    },
    "primitive": {
      "type": "object",
      "required": [
        "order_index",
        "text",
        "bbox",
        "provenance"
      ],
      "properties": {
        "order_index": {
          "type": "integer",
          "minimum": 0
        },
        "text": {
          "type": "string"
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "provenance": {
          "const": "embedded_pdf_text"
        }
      }
    },
    "span": {
      "allOf": [
        {
          "$ref": "#/$defs/primitive"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "order_index": true,
            "text": true,
            "bbox": true,
            "provenance": true,
            "font_name": {
              "type": "string"
            },
            "font_size": {
              "type": "number",
              "minimum": 0
            },
            "font_flags": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      ]
    },
    "line": {
      "allOf": [
        {
          "$ref": "#/$defs/primitive"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "spans"
          ],
          "properties": {
            "order_index": true,
            "text": true,
            "bbox": true,
            "provenance": true,
            "spans": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/span"
              }
            }
          }
        }
      ]
    },
    "block": {
      "allOf": [
        {
          "$ref": "#/$defs/primitive"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lines"
          ],
          "properties": {
            "order_index": true,
            "text": true,
            "bbox": true,
            "provenance": true,
            "lines": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/line"
              }
            }
          }
        }
      ]
    },
    "span_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "block_index",
        "line_index",
        "span_index"
      ],
      "properties": {
        "block_index": {
          "type": "integer",
          "minimum": 0
        },
        "line_index": {
          "type": "integer",
          "minimum": 0
        },
        "span_index": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_index",
        "column_index",
        "row_span",
        "column_span",
        "bbox",
        "text",
        "span_refs"
      ],
      "properties": {
        "row_index": {
          "type": "integer",
          "minimum": 0
        },
        "column_index": {
          "type": "integer",
          "minimum": 0
        },
        "row_span": {
          "const": 1
        },
        "column_span": {
          "const": 1
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "text": {
          "type": "string"
        },
        "span_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/span_ref"
          }
        }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order_index",
        "bbox",
        "row_count",
        "column_count",
        "provenance",
        "cells"
      ],
      "properties": {
        "order_index": {
          "type": "integer",
          "minimum": 0
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "row_count": {
          "type": "integer",
          "minimum": 2
        },
        "column_count": {
          "type": "integer",
          "minimum": 2
        },
        "provenance": {
          "const": "derived_pdf_table"
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cell"
          }
        }
      }
    },
    "table_extraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "algorithm",
        "algorithm_version",
        "library",
        "library_version",
        "candidate_count",
        "accepted_count",
        "rejected_count",
        "rejection_counts"
      ],
      "properties": {
        "status": {
          "enum": [
            "completed",
            "no_candidates",
            "extraction_error"
          ]
        },
        "algorithm": {
          "const": "pymupdf_lines_strict"
        },
        "algorithm_version": {
          "const": "1"
        },
        "library": {
          "const": "PyMuPDF"
        },
        "library_version": {
          "const": "1.28.2"
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "accepted_count": {
          "type": "integer",
          "minimum": 0
        },
        "rejected_count": {
          "type": "integer",
          "minimum": 0
        },
        "rejection_counts": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "insufficient_dimensions": {
              "type": "integer",
              "minimum": 1
            },
            "invalid_shape": {
              "type": "integer",
              "minimum": 1
            },
            "merged_or_missing_cell": {
              "type": "integer",
              "minimum": 1
            },
            "invalid_cell_geometry": {
              "type": "integer",
              "minimum": 1
            },
            "ambiguous_span_mapping": {
              "type": "integer",
              "minimum": 1
            },
            "overlapping_candidate": {
              "type": "integer",
              "minimum": 1
            },
            "extraction_error": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
