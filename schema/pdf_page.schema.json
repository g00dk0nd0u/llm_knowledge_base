{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pdf_page.schema.json",
  "title": "Generated source-faithful PDF page primitives",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id", "source_file", "source_sha256", "page", "width_points",
    "height_points", "rotation", "media_box", "crop_box", "coordinate_space",
    "extraction_status", "image_count", "drawing_count", "text_blocks"
  ],
  "properties": {
    "document_id": { "type": "string", "pattern": "^doc-[a-f0-9]{24}$" },
    "source_file": { "type": "string", "pattern": "^projects/[^/]+/source/.+\\.[Pp][Dd][Ff]$" },
    "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "page": { "type": "integer", "minimum": 1 },
    "width_points": { "type": "number", "exclusiveMinimum": 0 },
    "height_points": { "type": "number", "exclusiveMinimum": 0 },
    "rotation": { "enum": [0, 90, 180, 270] },
    "media_box": { "$ref": "#/$defs/bbox" },
    "crop_box": { "$ref": "#/$defs/bbox" },
    "coordinate_space": { "const": "pdf_points_top_left" },
    "extraction_status": { "enum": ["extracted", "minimal_text", "no_text"] },
    "image_count": { "type": "integer", "minimum": 0 },
    "drawing_count": { "type": "integer", "minimum": 0 },
    "text_blocks": {
      "type": "array",
      "items": { "$ref": "#/$defs/block" }
    }
  },
  "$defs": {
    "bbox": {
      "type": "array",
      "prefixItems": [
        { "type": "number" }, { "type": "number" },
        { "type": "number" }, { "type": "number" }
      ],
      "items": false,
      "minItems": 4
    },
    "primitive": {
      "type": "object",
      "required": ["order_index", "text", "bbox", "provenance"],
      "properties": {
        "order_index": { "type": "integer", "minimum": 0 },
        "text": { "type": "string" },
        "bbox": { "$ref": "#/$defs/bbox" },
        "provenance": { "const": "embedded_pdf_text" }
      }
    },
    "span": {
      "allOf": [
        { "$ref": "#/$defs/primitive" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "order_index": true, "text": true, "bbox": true, "provenance": true,
            "font_name": { "type": "string" },
            "font_size": { "type": "number", "minimum": 0 },
            "font_flags": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    "line": {
      "allOf": [
        { "$ref": "#/$defs/primitive" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["spans"],
          "properties": {
            "order_index": true, "text": true, "bbox": true, "provenance": true,
            "spans": { "type": "array", "items": { "$ref": "#/$defs/span" } }
          }
        }
      ]
    },
    "block": {
      "allOf": [
        { "$ref": "#/$defs/primitive" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["lines"],
          "properties": {
            "order_index": true, "text": true, "bbox": true, "provenance": true,
            "lines": { "type": "array", "items": { "$ref": "#/$defs/line" } }
          }
        }
      ]
    }
  }
}
